# Copy to docker/.env and replace EVERY value. .env is git-ignored.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(36))"

# Signing key for access tokens (32+ characters)
JWT_SECRET=

# Password shared by the four demo accounts created on first start (12+ characters)
DEMO_PASSWORD=

# SQL Server requires a complex password (8+ chars with upper, lower, digit and symbol)
MSSQL_SA_PASSWORD=

# HMAC key that senders use to sign events posted to the Node.js intake service (32+ characters)
INTAKE_SIGNING_SECRET=

POSTGRES_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
